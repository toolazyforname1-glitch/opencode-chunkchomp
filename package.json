{
  "name": "chunkchomp",
  "version": "1.0.0",
  "description": "Context compaction for OpenCode: flags oversized tool output, the model replaces it with a dense summary, the original stays on disk.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "toolazyforname1-glitch"
  },
  "homepage": "https://github.com/toolazyforname1-glitch/opencode-chunkchomp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolazyforname1-glitch/opencode-chunkchomp.git"
  },
  "bugs": {
    "url": "https://github.com/toolazyforname1-glitch/opencode-chunkchomp/issues"
  },
  "main": "./src/chunkchomp.v1.js",
  "exports": {
    ".": "./src/chunkchomp.v2.js",
    "./v1": "./src/chunkchomp.v1.js"
  },
  "files": [
    "src",
    "tools",
    "docs",
    "chunkchomp.txt",
    "INSTRUCTIONS.template.md",
    "README.md",
    "DEV.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context",
    "compaction",
    "tokens",
    "tokenizer",
    "plugin",
    "llm",
    "ai"
  ],
  "scripts": {
    "validate": "node --check src/chunkchomp.v1.js && node --check src/chunkchomp.v2.js"
  }
}
